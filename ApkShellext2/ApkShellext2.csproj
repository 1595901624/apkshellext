<Project Sdk="Microsoft.NET.Sdk">

  <!-- SDK-style since 3.4.5-local (modernization). Builds on BOTH toolchains with no
       extra command-line properties:
         dotnet SDK (coreclr MSBuild)  -> satellites via Csc, preserialized resources below
         Visual Studio MSBuild (FullFramework) -> satellites via AL.exe, classic resources
       The old-style project is preserved in git history. -->

  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <Configurations>Debug;Debug2;Release</Configurations>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>ApkShellext2</RootNamespace>
    <AssemblyName>ApkShellext2</AssemblyName>
    <!-- keep the output at bin\Debug|Release (no net48\ subfolder): install bat files,
         postbuild.cmd and the docs all assume the flat layout -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AssemblyTitle>ApkShellext2</AssemblyTitle>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Svg 3.5.0 is source-embedded and needs modern language features on net48 -->
    <LangVersion>10.0</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- legacy: Debug/Debug2 full pdb + no opt; Release pdbonly + opt (unchanged) -->
    <DebugType Condition="'$(Configuration)' != 'Release'">full</DebugType>
    <DebugType Condition="'$(Configuration)' == 'Release'">pdbonly</DebugType>
    <Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>
    <!-- Debug2 is the legacy signed-local-debug config: behaves like Debug -->
    <DefineConstants Condition="'$(Configuration)' == 'Debug2'">$(DefineConstants);DEBUG</DefineConstants>
    <!-- NETFULL drives the net-framework code paths in Svg 3.5.0 sources.
         NETFRAMEWORK/NET48/NET462_OR_GREATER are auto-defined by the SDK for net48. -->
    <DefineConstants>$(DefineConstants);NETFULL</DefineConstants>

    <!-- Assembly attributes (version/Guid/ComVisible/NeutralResourcesLanguage) come
         from Properties\AssemblyInfo.cs; no generated Attributes file. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>

    <!-- Strong naming: the .snk is NOT in the repo (gitignored) - generate one locally,
         see compile_guidance.md §4.3. Roslyn signs directly; no sn.exe needed. -->
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>apkshellext2_hy.snk</AssemblyOriginatorKeyFile>

    <!-- coreclr GenerateResource cannot deserialize legacy BinaryFormatter resx payloads
         (non-string resources: images/icons) without preserialized mode; FullFramework
         MSBuild (Visual Studio) uses the classic reader and must NOT set this, because
         preserialized .resources embed System.Resources.Extensions types.
         Keying on MSBuildRuntimeType makes plain `dotnet build` and plain VS/msbuild
         builds each do the right thing with zero extra flags. -->
    <GenerateResourceUsePreserializedResources Condition="'$(MSBuildRuntimeType)' == 'Core'">true</GenerateResourceUsePreserializedResources>

    <!-- Submodule/legacy trees contain sources we deliberately do not compile;
         keep item globs explicit and let the repo layout drive them. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
  </PropertyGroup>

  <PropertyGroup>
    <!-- the generator project only knows Debug/Release; map Debug2 onto Debug -->
    <SvgGeneratorConfig Condition="'$(Configuration)' == 'Debug2'">Debug</SvgGeneratorConfig>
  </PropertyGroup>

  <ItemGroup>
    <!-- main sources (project root). ApkChunk.cs is dev tooling compiled only into
         apkshellextTest (stripped from the shell dll in 3.4.4). -->
    <Compile Include="*.cs" Exclude="ApkChunk.cs" />
    <Compile Include="Properties\**\*.cs" />
    <Compile Update="Preferences.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Preferences.Designer.cs">
      <DependentUpon>Preferences.cs</DependentUpon>
    </Compile>
    <Compile Update="Properties\Resources1.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <Compile Update="Properties\NonLocalizeResources.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>NonLocalizeResources.resx</DependentUpon>
    </Compile>
    <Compile Update="Properties\Settings.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>

    <!-- small vendored sources, pinned files -->
    <Compile Include="PlistCS\PlistCS\Src\Plist.cs" />
    <Compile Include="PNGDecrush\PNGDecrush\*.cs" />
    <Compile Include="WebP-wrapper\WebPTest\WebPWrapper.cs" />

    <!-- Svg 3.5.0 (v3.5.0 tag, source-embedded). Generated\ is the legacy pregen output
         folder - always excluded now that Svg.Generators runs as an analyzer below. -->
    <Compile Include="SVG\Source\**\*.cs" />
    <Compile Remove="SVG\Source\Properties\**\*.cs" />
    <Compile Remove="SVG\Source\Generated\**\*.cs" />

    <!-- SharpShell 2.7.1 (vendored sources). Excluded beyond the old compile list:
         RegAsm.cs + Properties\AssemblyInfo.cs + SharpDeskBand\ (never compiled before
         either). NativeBridge\, SharpPropertySheet\ and the SharpShellNativeBridge\
         native project were physically deleted (dead property-sheet host needing the
         SharpShellNativeBridge32/64.dll binaries that upstream removed; no compiled
         file referenced those namespaces). -->
    <Compile Include="SharpShell\SharpShell\SharpShell\**\*.cs" />
    <Compile Remove="SharpShell\SharpShell\SharpShell\Properties\AssemblyInfo.cs" />
    <Compile Remove="SharpShell\SharpShell\SharpShell\Helpers\RegAsm.cs" />
    <Compile Remove="SharpShell\SharpShell\SharpShell\SharpDeskBand\**\*.cs" />
    <Compile Update="SharpShell\SharpShell\SharpShell\SharpPreviewHandler\PreviewHandlerControl.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="SharpShell\SharpShell\SharpShell\SharpPreviewHandler\PreviewHandlerHost.cs">
      <SubType>Form</SubType>
    </Compile>

    <!-- SharpZipLib v1.4.2 (official icsharpcode tag, source-embedded; was kkguo fork
         @v0.86-era; BZip2 is REQUIRED - ZipFile.cs references it).
         Exclusions: unused codecs (GZip/Lzw/Tar, incl. its only System.Memory dependency
         ExactMemoryPool.cs) match the pre-upgrade compile surface; AssemblyInfo.cs
         excluded (host owns asm attributes). -->
    <Compile Include="SharpZipLib\src\ICSharpCode.SharpZipLib\**\*.cs" />
    <Compile Remove="SharpZipLib\src\ICSharpCode.SharpZipLib\AssemblyInfo.cs" />
    <Compile Remove="SharpZipLib\src\ICSharpCode.SharpZipLib\GZip\**\*.cs" />
    <Compile Remove="SharpZipLib\src\ICSharpCode.SharpZipLib\Lzw\**\*.cs" />
    <Compile Remove="SharpZipLib\src\ICSharpCode.SharpZipLib\Tar\**\*.cs" />
    <Compile Remove="SharpZipLib\src\ICSharpCode.SharpZipLib\Core\ExactMemoryPool.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Svg element metadata: Roslyn source generator runs in-process at compile time,
         replacing the old build\svg-pregen step (its output dir SVG\Source\Generated is
         excluded above). Works under any MSBuild (dotnet CLI or Visual Studio) because
         analyzers are compiler-side, not MSBuild-side. -->
    <ProjectReference Include="SVG\Generators\Svg.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      SetConfiguration="$(SvgGeneratorConfig)" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources1.Designer.cs</LastGenOutput>
      <SubType>Designer</SubType>
    </EmbeddedResource>
    <!-- 19 localized satellites, culture taken from the filename by the SDK -->
    <EmbeddedResource Include="Properties\Resources.*.resx" />
    <EmbeddedResource Include="Properties\NonLocalizeResources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>NonLocalizeResources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Include="Preferences.resx">
      <DependentUpon>Preferences.cs</DependentUpon>
      <SubType>Designer</SubType>
    </EmbeddedResource>
    <EmbeddedResource Include="SharpShell\SharpShell\SharpShell\SharpPreviewHandler\PreviewHandlerHost.resx">
      <DependentUpon>PreviewHandlerHost.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Include="SVG\Source\Resources\svg11.dtd">
      <LogicalName>Svg.Resources.svg11.dtd</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- framework references: kept explicit (the SDK adds no framework references for
         a .NET Framework target beyond the targeting-pack basics) -->
    <Reference Include="Microsoft.VisualBasic" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="System" />
    <Reference Include="System.ComponentModel.Composition" />
    <Reference Include="System.Configuration" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.EnterpriseServices" />
    <Reference Include="System.Security" />
    <Reference Include="System.Web" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Data" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Xaml" />
    <Reference Include="WindowsBase" />
    <!-- SvgElement/SvgElementIdManager use HttpClient for remote SVG loading. Resolved from
         the net48 targeting pack; on target machines the 4.8 runtime provides it from the
         GAC, so nothing extra is deployed next to the shell extension. -->
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <!-- NuGet via restore: System.Memory drags System.Buffers + System.Numerics.Vectors;
         the direct Unsafe 6.0.0 overrides its transitive 4.5.3 (nearest-wins), which is
         exactly what the old HintPath set resolved to. No more manual package fetching. -->
    <PackageReference Include="ExCSS" Version="4.2.3" />
    <PackageReference Include="System.Memory" Version="4.5.5" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.0.0" />
    <!-- only the coreclr resource path needs it at compile time (see the property above) -->
    <PackageReference Include="System.Resources.Extensions" Version="6.0.0"
                      Condition="'$(GenerateResourceUsePreserializedResources)' == 'true'" />
  </ItemGroup>

  <ItemGroup>
    <None Include="apkshellext2_hy.pfx" />
    <None Include="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
    <None Include="Resources\**\*.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources\Amazon.png" />
    <Content Include="Resources\output.png" />
    <Content Include="Resources\logo.png" />
    <Content Include="Resources\update.png" />
    <Content Include="Resources\Windows.png" />
    <Content Include="LibWebP\libwebp_x64.dll">
      <TargetPath>libwebp_x64.dll</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="LibWebP\libwebp_x86.dll">
      <TargetPath>libwebp_x86.dll</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Publish layout assembled by MSBuild (used to be copy commands at the top
       of Resources\postbuild.cmd; that script now only does 7z packaging).
       Content items are copied by CopyFilesToOutputDirectory during the build,
       before PostBuildEvent runs, so the output folder is already complete.
       TargetPath flattens each file to the output root - without it the
       Resources\/LibWebP\ source subfolders would be recreated in the output. -->
  <ItemGroup>
    <Content Include="Resources\install.bat">
      <TargetPath>install.bat</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\install_user.bat">
      <TargetPath>install_user.bat</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\uninstall.bat">
      <TargetPath>uninstall.bat</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\uninstall_user.bat">
      <TargetPath>uninstall_user.bat</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\restart_explorer.bat">
      <TargetPath>restart_explorer.bat</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Dev helper: Debug-only, so the Release *.bat wildcard in the 7z
         packaging step never picks it up. -->
    <Content Include="Resources\debug.bat" Condition="'$(Configuration)'=='Debug'">
      <TargetPath>debug.bat</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- 7z packaging step (Resources\postbuild.cmd). NOTE: implemented as an
       AfterBuild target, not the legacy <PostBuildEvent> property - in an SDK-style
       project a property assignment expands its macros at EVALUATION time, when
       $(ProjectDir)/$(TargetDir) are not defined yet, so the old one-liner would
       bake into `call "Resources\postbuild.cmd" "" ""`. Task parameters inside a
       target expand at execution time, when everything is known.
       The script exits 0 quickly when 7-Zip is absent; it only packages, never
       copies (the publish layout above is already in $(TargetDir) by then). -->
  <Target Name="PackageWith7z" AfterTargets="PostBuildEvent">
    <Exec Command="call &quot;$(MSBuildProjectDirectory)\Resources\postbuild.cmd&quot; &quot;$(TargetDir)&quot; &quot;$(MSBuildProjectDirectory)\&quot; $(Configuration)" />
  </Target>

</Project>
